# Copy to .env — never commit .env
# Only populate credentials for the selected LLM_PROVIDER.

# ---------------------------------------------------------------------------
# Common LLM settings
# ---------------------------------------------------------------------------
# Supported: openai | gemini | groq | openai_compatible | ollama
LLM_PROVIDER=openai
# Optional model override (provider defaults apply when empty):
#   openai             -> gpt-4o-mini
#   gemini             -> gemini-3.5-flash-lite
#   groq               -> llama-3.1-8b-instant
#   ollama             -> llama3.2  (must already be pulled; not auto-downloaded)
#   openai_compatible  -> REQUIRED (no default)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# openai — official OpenAI API
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# gemini — Google AI Gemini API
# ---------------------------------------------------------------------------
# LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# groq — Groq OpenAI-compatible chat completions
# ---------------------------------------------------------------------------
# LLM_PROVIDER=groq
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# openai_compatible — organiser / custom OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://example.invalid/v1
# OPENAI_COMPATIBLE_API_KEY=   # optional only if the endpoint allows unauthenticated access
# LLM_MODEL=your-model-id      # required for openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# ollama — local/remote Ollama OpenAI-compatible API (no cloud key)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Ensure the model in LLM_MODEL (or default llama3.2) is already available.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Observability / Action API (unchanged)
# ---------------------------------------------------------------------------
PROMETHEUS_URL=http://127.0.0.1:9090
JAEGER_URL=http://127.0.0.1:16686
OPENSEARCH_URL=http://127.0.0.1:9200
# If 9200 is ephemeral: docker compose -f compose.yaml -f compose.observability.yaml port opensearch 9200
ACTION_API_URL=
KILL_SWITCH=0
